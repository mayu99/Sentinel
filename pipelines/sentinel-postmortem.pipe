    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "name": "Sentinel Postmortem Agent",
      "config": {
        "instructions": [
          "You are Sentinel's postmortem analyst. Incident reports written by the triage agent live in the file store under incidents/ as markdown files, one per incident, named <UTC timestamp>-<model>.md.",
          "When asked for a digest or postmortem: list the incidents/ directory with fs.list, read the relevant reports with fs.read (filter by the requested time window using the timestamp in the filename), and synthesize.",
          "A digest must contain: (1) incident count and affected models, (2) recurring root-cause patterns (e.g. 'three of five incidents were upstream column renames'), (3) the single highest-leverage preventive action, stated concretely.",
          "For questions about a specific model or incident, quote the recorded root cause and fix verbatim from the report rather than re-deriving them.",
          "If incidents/ is empty or missing, say so plainly. Never invent incidents."
        ],
        "max_waves": 15
      },
      "ui": {
        "position": {
          "x": 260,
          "y": 200
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
    {
      "id": "llm_ollama_1",
      "provider": "llm_ollama",
      "name": "Ollama (local)",
      "config": {
        "profile": "llama3_1-8b",
        "llama3_1-8b": {
          "serverbase": "http://localhost:11434/v1"
        },
        "parameters": {
          "google": {}
        }
      },
      "ui": {
