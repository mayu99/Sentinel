{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "name": "Failure Intake",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": { "x": 20, "y": 200 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "name": "Sentinel Triage Agent",
      "config": {
        "instructions": [
          "You are Sentinel, an on-call incident triage agent for data pipelines. You receive a failure event from a dbt or Airflow run as JSON (job name, failed model, error message, log excerpt).",
          "Triage protocol — follow in order:",
          "1. PARSE: Read the failure payload. Identify the failed model, the error class (missing column, type mismatch, constraint violation, timeout, permission), and the exact object names mentioned in the error.",
          "2. INSPECT SOURCE: Use warehouse.get_schema to fetch the current schema of the upstream table(s) the failed model reads from. Use warehouse.get_data with a SELECT to sample rows or check counts/freshness if relevant.",
          "3. DIAGNOSE DRIFT: Compare what the model's SQL expects (columns named in the error and log excerpt) against the live schema. Use python.execute for any diffing, parsing, or date math. State the root cause as a single falsifiable sentence, e.g. 'Upstream table raw.customers renamed customer_email to email; stg_customers.sql still selects customer_email.'",
          "4. PROPOSE FIX: Write the minimal concrete fix — the exact SQL change or config change — and one guardrail to prevent recurrence (e.g. a dbt source freshness test or a schema contract).",
          "5. RECORD: Write the full incident report as markdown to the file store at incidents/<UTC timestamp>-<model>.md using fs.write.",
          "6. NOTIFY: If Slack tools are available, post a concise incident summary (root cause + fix, under 120 words) to the channel #data-incidents with slack.message_post. If Slack is not available, skip without failing.",
          "Always finish by returning the incident report. Never invent schema details — every column claim must come from warehouse.get_schema output. If you cannot determine the root cause, say so and list what you ruled out."
        ],
        "max_waves": 20,
        "parameters": {}
      },
      "ui": {
        "position": { "x": 260, "y": 200 },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        { "lane": "questions", "from": "webhook_1" }
      ]
    },
    {
      "id": "llm_ollama_1",
      "provider": "llm_ollama",
      "name": "Ollama (local)",
      "config": {
        "profile": "llama3_1-8b",
        "llama3_1-8b": {},
        "parameters": {}
      },
      "ui": {
        "position": { "x": 120, "y": 380 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "llm", "from": "agent_rocketride_1" },
        { "classType": "llm", "from": "db_postgres_1" }
      ]
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "name": "Memory (Internal)",
      "config": {
        "type": "memory_internal"
      },
      "ui": {
        "position": { "x": 300, "y": 380 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "memory", "from": "agent_rocketride_1" }
      ]
    },
    {
      "id": "db_postgres_1",
      "provider": "db_postgres",
      "name": "Warehouse (Postgres)",
      "config": {
        "type": "db_postgres",
        "serverName": "warehouse",
        "host": "${SENTINEL_PG_HOST}",
        "database": "${SENTINEL_PG_DB}",
        "user": "${SENTINEL_PG_USER}",
        "password": "${SENTINEL_PG_PASSWORD}",
        "parameters": {}
      },
      "ui": {
        "position": { "x": 480, "y": 380 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "tool", "from": "agent_rocketride_1" }
      ]
    },
    {
      "id": "tool_python_1",
      "provider": "tool_python",
      "name": "Python Sandbox",
      "config": {
        "type": "tool_python",
        "serverName": "python",
        "timeout": 60,
        "allowedModules": ["difflib", "textwrap"]
      },
      "ui": {
        "position": { "x": 660, "y": 380 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "tool", "from": "agent_rocketride_1" }
      ]
    },
    {
      "id": "tool_filesystem_1",
      "provider": "tool_filesystem",
      "name": "Incident Store",
      "config": {
        "type": "tool_filesystem"
      },
      "ui": {
        "position": { "x": 840, "y": 380 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "tool", "from": "agent_rocketride_1" }
      ]
    },
    {
      "id": "tool_slack_1",
      "provider": "tool_slack",
      "name": "Slack",
      "config": {
        "type": "tool_slack",
        "token": "${ROCKETRIDE_SLACK_TOKEN}",
        "webhookUrl": ""
      },
      "ui": {
        "position": { "x": 1020, "y": 380 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "tool", "from": "agent_rocketride_1" }
      ]
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Incident Report",
      "config": {
        "laneName": "answers"
      },
      "ui": {
        "position": { "x": 520, "y": 200 },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        { "lane": "answers", "from": "agent_rocketride_1" }
      ]
    }
  ],
  "version": 1,
  "isLocked": false,
  "snapToGrid": true,
  "snapGridSize": [10, 10],
  "docRevision": 1
}
