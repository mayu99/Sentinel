        "name": "Gemini",
        "parameters": {
          "google": {}
        },
        "5-flash": {
          "apikey": "${ROCKETRIDE_GEMINI_KEY}"
        }
      },
      "ui": {
        "position": {
          "x": -50,
          "y": 390
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "llm",
          "from": "agent_rocketride_1"
        },
        {
          "classType": "llm",
          "from": "db_postgres_1"
        }
      ]
    },
    {
