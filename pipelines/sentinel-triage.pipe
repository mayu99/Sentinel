{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "name": "Failure Intake",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": {
          "x": -90,
          "y": 140
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "name": "Sentinel Triage Agent",
      "config": {
        "agent_description": "Triages failed dbt/Airflow pipeline runs by inspecting live warehouse schema, diagnosing drift, proposing fixes, and recording incident reports.",
        "instructions": [
          "You are Sentinel, an on-call incident triage agent for data pipelines. You receive a failure event from a dbt or Airflow run as JSON (job name, failed model, error message, log excerpt).",
          "Triage protocol — follow in order:",
          "1. PARSE: Read the failure payload. Identify the failed model, the error class (missing column, type mismatch, constraint violation, timeout, permission), and the exact object names mentioned in the error.",
          "2. INSPECT SOURCE: Use postgres.get_schema to fetch the current schema of the upstream table(s) the failed model reads from. Use postgres.get_data with a SELECT to sample rows or check counts/freshness if relevant. (Method names are UNVERIFIED — the db_postgres schema only confirms the 'postgres' prefix, not the method suffixes. Confirm against the actual tool-call schema on first run.)",
          "3. DIAGNOSE DRIFT: Compare what the model's SQL expects (columns named in the error and log excerpt) against the live schema. Use python.execute for any diffing, parsing, or date math. State the root cause as a single falsifiable sentence, e.g. 'Upstream table raw.customers renamed customer_email to email; stg_customers.sql still selects customer_email.'",
          "4. PROPOSE FIX: Write the minimal concrete fix — the exact SQL change or config change — and one guardrail to prevent recurrence (e.g. a dbt source freshness test or a schema contract).",
          "5. RECORD: Write the full incident report as markdown to the file store at incidents/<UTC timestamp>-<model>.md using fs.write.",
          "6. NOTIFY: If the Slack webhook tool is available, POST a JSON payload ({\"text\": \"<summary>\"}) containing a concise incident summary (root cause + fix, under 120 words) to the Slack incoming webhook URL using slack.http_request (POST). If the tool is not available, skip without failing.",
          "Always finish by returning the incident report. Never invent schema details — every column claim must come from postgres.get_schema output. If you cannot determine the root cause, say so and list what you ruled out."
        ],
        "max_waves": 20,
        "parameters": {
          "google": {}
        }
      },
      "ui": {
        "position": {
          "x": 340,
          "y": 110
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "question_1"
        }
      ]
    },
    {
      "id": "llm_ollama_1",
      "provider": "llm_ollama",
      "name": "Ollama (local)",
      "config": {
        "profile": "llama3_1-8b",
        "llama3_1-8b": {
          "serverbase": "http://localhost:11434/v1"
        }
      },
      "ui": {
        "position": {
          "x": 120,
          "y": 390
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "name": "Memory (Internal)",
      "config": {
        "type": "memory_internal"
      },
      "ui": {
        "position": {
          "x": 300,
          "y": 380
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "memory",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "db_postgres_1",
      "provider": "db_postgres",
      "name": "Warehouse (Postgres)",
      "config": {
        "profile": "default",
        "default": {
          "allow_execute": true,
          "database": "${ROCKETRIDE_PG_DB}",
          "db_description": "Sentinel data warehouse — upstream source tables read by the dbt/Airflow models under triage.",
          "host": "${ROCKETRIDE_PG_HOST}",
          "max_attempts": 5,
          "table": "raw.customers",
          "user": "${ROCKETRIDE_PG_USER}",
          "password": "${ROCKETRIDE_PG_PASSWORD}"
        },
        "parameters": {
          "google": {}
        }
      },
      "ui": {
        "position": {
          "x": 480,
          "y": 380
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "tool_python_1",
      "provider": "tool_python",
      "name": "Python Sandbox",
      "config": {
        "type": "tool_python",
        "timeout": 60,
        "allowedModules": [
          {
            "moduleName": "difflib"
          },
          {
            "moduleName": "textwrap"
          }
        ]
      },
      "ui": {
        "position": {
          "x": 660,
          "y": 380
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "tool_filesystem_1",
      "provider": "tool_filesystem",
      "name": "Incident Store",
      "config": {
        "type": "tool_filesystem",
        "allowRead": true,
        "allowWrite": true,
        "allowList": true,
        "allowMkdir": true,
        "allowStat": true,
        "allowDelete": false
      },
      "ui": {
        "position": {
          "x": 840,
          "y": 380
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "tool_http_request_1",
      "provider": "tool_http_request",
      "name": "Slack Webhook (HTTP)",
      "config": {
        "type": "tool_http_request",
        "serverName": "slack",
        "allowGET": false,
        "allowPOST": true,
        "allowPUT": false,
        "allowPATCH": false,
        "allowDELETE": false,
        "allowHEAD": false,
        "allowOPTIONS": false,
        "urlWhitelist": [
          {
            "whitelistPattern": "^https://hooks\\.slack\\.com/"
          }
        ],
        "rateLimitPerSecond": 10,
        "rateLimitPerMinute": 100,
        "maxConcurrentRequests": 5
      },
      "ui": {
        "position": {
          "x": 1020,
          "y": 380
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Incident Report",
      "config": {
        "laneName": "answers"
      },
      "ui": {
        "position": {
          "x": 520,
          "y": 200
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "answers",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "llm_gemini_1",
      "provider": "llm_gemini",
      "name": "Gemini",
      "config": {
        "profile": "gemini-2_5-flash",
