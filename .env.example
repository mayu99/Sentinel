# Warehouse the triage agent inspects (matches demo/docker-compose.yml)
ROCKETRIDE_PG_HOST=localhost:5544
ROCKETRIDE_PG_DB=warehouse
ROCKETRIDE_PG_USER=sentinel
ROCKETRIDE_PG_PASSWORD=sentinel

# Optional: Slack bot token for #data-incidents notifications.
# Leave unset to run the demo without Slack — the agent skips the notify step.
ROCKETRIDE_SLACK_TOKEN=
